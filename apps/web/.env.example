# Copy to apps/web/.env.local (Next.js only reads env files from its own
# directory) and fill in from the Supabase project's API settings.
#
# Both values are publishable and end up in the browser bundle. That is fine by
# design: is_authorized()-backed RLS is what actually protects the data, not the
# secrecy of these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The app's own public origin, e.g. https://ben-os.vercel.app — no trailing
# slash needed. Only used to build the post-sign-in redirect. Set it on any
# deployment sitting behind a proxy, where the request's own origin is the
# internal one; leave it empty locally.
NEXT_PUBLIC_SITE_URL=

# --- Everything below is server-side only. None of it is NEXT_PUBLIC_, and none
# --- of it may become so: each one is a credential.

# The SimpleFIN Access URL, with its Basic Auth credentials embedded
# (scheme://user:pass@host/path). Obtained once by POSTing a Setup Token to
# /api/financials/claim — a token can only be claimed once, so keep the result.
#
# Deliberately not a database row (ADR 0002): it is one credential covering the
# whole Bridge subscription, so a database leak must not also be a bank leak.
SIMPLEFIN_ACCESS_URL=

# Postgres connection string for the sync job, from Supabase → Project Settings
# → Database. The web app's page reads go through PostgREST and the anon key
# above; this is only for the scheduled job, which has no session to use.
#
# Append `?sslmode=no-verify` for Supabase — its certificate is signed by a CA
# that isn't in Node's trust store, and the connection string is where that
# decision belongs, not in code.
#
# The job still connects, then drops to the `authenticated` role and presents
# the authorized email as a JWT claim, so RLS applies to it too. Do not swap
# this for a service-role connection: that would bypass every policy.
DATABASE_URL=

# Shared secret gating /api/cron/*. Vercel Cron sends it as `Authorization:
# Bearer <secret>`; set the same value in the Vercel project's env. Any long
# random string works — `openssl rand -hex 32`.
#
# An unset value fails closed (the route 401s), so a forgotten secret means no
# syncs rather than an open endpoint.
CRON_SECRET=
