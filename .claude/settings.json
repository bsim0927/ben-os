{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__supabase__execute_sql|mcp__supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-supabase-sql.py\"",
            "timeout": 10,
            "statusMessage": "Checking SQL for destructive statements"
          }
        ]
      }
    ]
  }
}
